<configuration>
  <system.webServer>
    <!-- Serve the static homepage for directory requests. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Canonicalize requests to HTTPS at www.demads.nl. -->
    <rewrite>
      <rules>
        <rule name="Redirect to canonical HTTPS hostname" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^www\.demads\.nl$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.demads.nl/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
